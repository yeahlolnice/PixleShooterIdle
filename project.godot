; Engine configuration file.
; Edit through the Godot editor or by hand; keep keys sorted by section.

config_version=5

[application]

config/name="Cheat Code Idle"
config/description="Single-player voxel arena shooter with an incremental cheat ladder."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://autoload/event_bus.gd"
DataRegistry="*res://autoload/data_registry.gd"
GameState="*res://autoload/game_state.gd"
SteamService="*res://autoload/steam_service.gd"
CheatSystem="*res://cheats/cheat_system.gd"
ChatSystem="*res://autoload/chat_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

