{
  "channels": {
    "system": {"sender": "SYSTEM", "color": "chat_system", "format": "[{sender}] {text}"},
    "seller": {"sender": "x_Hax_x", "color": "chat_seller", "format": "[DM] {sender}: {text}"},
    "bot": {"sender": "", "color": "chat_bot", "format": "{sender}: {text}"}
  },
  "ui": {
    "log_title": "CHAT LOG  (T / ENTER / ESC to close)",
    "mute_bots": "Mute bot chat"
  },
  "box": {
    "visible_lines": 6,
    "fade_after_s": 8.0,
    "fade_time_s": 1.5,
    "log_max_lines": 200
  },
  "bot_names": ["xX_Grunt_Xx", "camper_dave", "n00bmaster", "BlockyBoi", "Sir_Spawns_Alot", "pixel_pete"],
  "triggers": [
    {"id": "tut_welcome", "event": "first_match", "channel": "system", "once": true, "delay_s": 0.5,
     "lines": ["Welcome to the server. WASD to move, SPACE to jump, mouse to look around."]},
    {"id": "tut_buy_menu", "event": "first_match", "channel": "system", "once": true, "delay_s": 3.0,
     "lines": ["Freeze time! Press B to open the buy menu. Better guns cost cash, and you lose them when you die."]},
    {"id": "tut_shoot", "event": "round_live", "channel": "system", "once": true, "delay_s": 0.0,
     "lines": ["Round is live. LEFT CLICK to shoot, R to reload. Kills pay cash, headshots pay more."]},
    {"id": "tut_chat_log", "event": "round_live", "channel": "system", "once": true, "delay_s": 6.0,
     "lines": ["Missed something? Press T or ENTER to scroll the chat log."]},
    {"id": "seller_intro", "event": "first_cash", "channel": "seller", "once": true, "delay_s": 1.5,
     "lines": ["psst. saw that. ${amount} for a kill? cute. want it to be easy?"]},
    {"id": "seller_insert", "event": "first_cash", "channel": "seller", "once": true, "delay_s": 4.0,
     "lines": ["press INSERT. trust me. my menu, my prices, no refunds."]},
    {"id": "tut_mod_menu", "event": "first_cash", "channel": "system", "once": true, "delay_s": 5.0,
     "lines": ["INSERT (or F1) opens the mod menu. Spend cash on cheats there, any time."]},
    {"id": "tut_round_two", "event": "round_start", "channel": "system", "once": true, "delay_s": 0.5,
     "when": {"round": "2"},
     "lines": ["Every round starts with freeze time: B for guns, INSERT for cheats."]},
    {"id": "sys_unlock", "event": "cheat_unlocked", "channel": "system", "once": false, "delay_s": 0.0,
     "lines": ["New cheat unlocked: {cheat_name}."]},
    {"id": "seller_unlock", "event": "cheat_unlocked", "channel": "seller", "once": true, "once_key": "seller_unlock_{cheat_id}", "delay_s": 1.0,
     "lines": ["{cheat_name} just dropped. INSERT. you know the drill.", "fresh {cheat_name}, barely detected. go go go"]},
    {"id": "sys_purchase", "event": "cheat_purchased", "channel": "system", "once": true, "once_key": "sys_purchase_{cheat_id}", "delay_s": 0.0,
     "when": {"level": "1"},
     "lines": ["{cheat_name} injected. Toggle it on or off in the mod menu."]},
    {"id": "seller_purchase", "event": "cheat_purchased", "channel": "seller", "once": true, "once_key": "seller_purchase_{cheat_id}", "delay_s": 1.5,
     "when": {"level": "1"},
     "lines": ["pleasure doing business. {cheat_name} is yours. upgrades make it stupid good."]},
    {"id": "seller_first_use", "event": "cheat_first_use", "channel": "seller", "once": true, "once_key": "seller_first_use_{cheat_id}", "delay_s": 4.0,
     "lines": ["see? {cheat_name} on. nobody will notice. probably."]},
    {"id": "tut_death", "event": "player_died", "channel": "system", "once": true, "delay_s": 0.5,
     "lines": ["You died. You lose your gun and your streak, never your cash or cheats."]},
    {"id": "bot_taunt", "event": "player_died", "channel": "bot", "once": false, "delay_s": 0.8, "chance": 0.5,
     "lines": ["gg ez", "sit down", "lol", "who taught you to aim"]},
    {"id": "bot_headshot", "event": "bot_killed", "channel": "bot", "once": false, "delay_s": 0.6, "chance": 0.25,
     "when": {"headshot": "true"},
     "lines": ["nice shot", "bro is cracked", "how", "lucky"]},
    {"id": "sys_mod_spawned", "event": "mod_spawned", "channel": "system", "once": true, "delay_s": 0.0,
     "lines": ["An anti-cheat MOD joined. Mods switch your cheats off for a while."]},
    {"id": "seller_mod_spawned", "event": "mod_spawned", "channel": "seller", "once": false, "delay_s": 1.0,
     "lines": ["mod in the server. act natural.", "uh oh. a mod. shoot it before it sees you."]},
    {"id": "seller_prestige", "event": "prestige", "channel": "seller", "once": false, "delay_s": 1.0,
     "lines": ["banned #{count}. new account, same me. let's go again."]}
  ]
}
